# Supabase Online Database Configuration (PostgreSQL 15/16 + pgvector)
# Replace with your project details from Supabase Dashboard -> Project Settings -> Database
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct Connection (port 5432) or Supavisor Pooler (port 6543 / 5432)
SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-supabase-db-password

# JDBC URL for Spring Boot (auto-assembled or custom override)
DATABASE_URL=jdbc:postgresql://${SUPABASE_DB_HOST}:${SUPABASE_DB_PORT}/${SUPABASE_DB_NAME}?sslmode=require

# Redis Configuration (Redis 7) - local docker container
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Spring Boot API
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
API_BASE_URL=http://localhost:8080

# Next.js Web App
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
PORT=3000

# Resend Email Notifications (Spring Boot)
# Get your API key from https://resend.com/api-keys
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key_here
CONTACT_TO_EMAIL=priyanshu.kr.sinha74@gmail.com
CONTACT_FROM_EMAIL=contact@priyanshusinha.dev
NOTIFICATION_LOG_ONLY=true

